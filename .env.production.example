# ==============================================================================
# UZHAVAN AI - PRODUCTION ENVIRONMENT VARIABLES (.env)
# ==============================================================================
# Copy this file to `.env` on your AWS EC2 instance and fill in your API keys.

# ── 1. FRONTEND & GENERAL SETTINGS ──
# Keep empty for automatic same-origin proxy via Nginx (/api/*)
VITE_API_URL=

# ── 2. AI & LLM PROVIDERS ──
# Google Gemini 2.0 Flash API Keys (https://aistudio.google.com)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_VOICE_KEY=your_backup_gemini_key_optional

# NVIDIA NIM Microservices (https://build.nvidia.com)
VITE_NVIDIA_API_KEY=your_nvidia_api_key_here
VITE_NVIDIA_GLM_KEY=your_nvidia_glm_key_here
VITE_NVIDIA_NEMOTRON_KEY=your_nvidia_nemotron_key_here
VITE_NVIDIA_WHISPER_KEY=your_nvidia_whisper_key_here
VITE_NVIDIA_WEATHER_KEY=your_nvidia_weather_key_here
VITE_NVIDIA_TTS_KEY=your_nvidia_tts_key_here
VITE_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Groq Cloud API (Optional fast fallback - https://console.groq.com)
VITE_GROQ_API_KEY=your_groq_api_key_here

# ── 3. FIREBASE CLIENT CONFIGURATION ──
VITE_FIREBASE_API_KEY=AIzaSyDvfHQ3bAFbe2kvkkEQOkKeU0kgZcTZIH4
VITE_FIREBASE_AUTH_DOMAIN=uzhavan-ai-686d6.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=uzhavan-ai-686d6
VITE_FIREBASE_STORAGE_BUCKET=uzhavan-ai-686d6.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=475933202478
VITE_FIREBASE_APP_ID=1:475933202478:web:996cf843478589cd96a7bf

# ── 4. BACKEND RUNTIME ──
PORT=8000
ENVIRONMENT=production
